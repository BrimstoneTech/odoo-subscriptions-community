<odoo>
    <data noupdate="1">
        <!-- Daily Renewal Engine -->
        <record id="ir_cron_flexirenew_reminders" model="ir.cron">
            <field name="name">FlexiRenew: Daily Renewal Alert Engine</field>
            <field name="model_id" ref="model_flexirenew_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_flexirenew_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
