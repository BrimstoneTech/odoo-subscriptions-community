<odoo>
    <data noupdate="1">
        <!-- Renewal Alert Template -->
        <record id="mail_template_renewal_alert" model="mail.template">
            <field name="name">FlexiRenew: Renewal Alert</field>
            <field name="model_id" ref="flexirenew.model_flexirenew_subscription"/>
            <field name="subject">Upcoming Renewal: {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <strong><t t-out="object.partner_id.name"/></strong>,<br/><br/>
                        This is a professional reminder regarding your upcoming renewal for: 
                        <span style="color: #2563EB; font-weight: bold;"><t t-out="object.name"/></span>.
                        <br/><br/>
                        <strong>Renewal Details:</strong><br/>
                        - Renewal Date: <t t-out="object.next_renewal_date"/><br/>
                        - Amount Due: <t t-out="object.amount"/> <t t-out="object.currency_id.name"/><br/>
                        <br/>
                        Please ensure all arrangements are made to avoid any service interruptions.
                        <br/><br/>
                        Best regards,<br/>
                        <t t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
