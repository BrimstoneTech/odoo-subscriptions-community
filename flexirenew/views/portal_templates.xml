<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal Home: Add Subscriptions Count -->
    <template id="portal_my_home_subscription" name="Show Subscriptions" customize_show="True" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Subscriptions</t>
                <t t-set="url" t-value="'/my/subscriptions'"/>
                <t t-set="placeholder_count" t-value="'subscription_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Portal Breadcrumbs -->
    <template id="portal_my_home_menu_subscription" name="Portal layout : subscription menu entries" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'subscription' or subscription" class="breadcrumb-item active">
                <a t-if="subscription" t-attf-href="/my/subscriptions?{{ keep_query() }}">Subscriptions</a>
                <t t-else="">Subscriptions</t>
            </li>
            <li t-if="subscription" class="breadcrumb-item active">
                <t t-esc="subscription.name"/>
            </li>
        </xpath>
    </template>

    <!-- Subscriptions List View -->
    <template id="portal_my_subscriptions" name="My Subscriptions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Subscriptions</t>
            </t>
            <t t-if="not subscriptions">
                <p>There are currently no subscriptions for your account.</p>
            </t>
            <t t-if="subscriptions" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Subscription Name</th>
                        <th class="text-end">Next Renewal</th>
                        <th class="text-end">Amount</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <t t-foreach="subscriptions" t-as="sub">
                    <tr>
                        <td><a t-attf-href="/my/subscriptions/#{sub.id}"><t t-esc="sub.name"/></a></td>
                        <td class="text-end"><span t-field="sub.next_renewal_date"/></td>
                        <td class="text-end"><span t-field="sub.amount" t-options='{"widget": "monetary", "display_currency": sub.currency_id}'/></td>
                        <td class="text-center">
                            <span t-if="sub.state == 'active'" class="badge rounded-pill text-bg-success"><i class="fa fa-fw fa-check"/> Active</span>
                            <span t-if="sub.state == 'past_due'" class="badge rounded-pill text-bg-danger">Past Due</span>
                            <span t-if="sub.state == 'suspended'" class="badge rounded-pill text-bg-warning">Suspended</span>
                            <span t-if="sub.state == 'cancel'" class="badge rounded-pill text-bg-secondary">Cancelled</span>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <!-- Subscription Details Page -->
    <template id="portal_subscription_page" name="Subscription Details">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" t-if="subscription.state == 'past_due'">
                <div class="alert alert-danger mb-4" role="alert">
                    <strong>Payment Required:</strong> Your subscription is currently past due. Please settle any outstanding invoices to maintain service.
                </div>
            </t>

            <div class="container mb-5">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <div class="row align-items-center">
                            <div class="col-sm-8">
                                <h3 class="mb-0"><t t-esc="subscription.name"/></h3>
                            </div>
                            <div class="col-sm-4 text-end">
                                <button t-if="subscription.state in ['active', 'past_due']" 
                                        type="button" 
                                        class="btn btn-outline-danger" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#cancelModal">
                                    Cancel Subscription
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="mb-2"><strong>Status:</strong> 
                                    <span t-field="subscription.state" class="badge rounded-pill text-bg-primary ms-2"/>
                                </div>
                                <div class="mb-2"><strong>Partner:</strong> <t t-esc="subscription.partner_id.name"/></div>
                                <div class="mb-2"><strong>Start Date:</strong> <span t-field="subscription.start_date"/></div>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <div class="mb-2"><strong>Next Renewal Date:</strong> <span t-field="subscription.next_renewal_date" class="fw-bold"/></div>
                                <div class="mb-2"><strong>Recurrence:</strong> <span t-field="subscription.frequency"/></div>
                                <h4 class="mt-3 text-primary">Total: <span t-field="subscription.amount" t-options='{"widget": "monetary", "display_currency": subscription.currency_id}'/></h4>
                            </div>
                        </div>

                        <h5 class="border-bottom pb-2 mb-3">Subscription Items</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="subscription.line_ids" t-as="line">
                                    <td><t t-esc="line.product_id.name"/><br/><small class="text-muted"><t t-esc="line.name"/></small></td>
                                    <td class="text-end"><t t-esc="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Cancellation Confirmation Modal -->
            <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <form t-attf-action="/my/subscriptions/#{subscription.id}/cancel" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="cancelModalLabel">Cancel Subscription?</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>Are you sure you want to cancel your subscription to <strong><t t-esc="subscription.name"/></strong>?</p>
                                <div class="alert alert-warning">
                                    <i class="fa fa-warning me-2"></i> 
                                    You will lose access to this service on <strong><t t-esc="subscription.next_renewal_date"/></strong>.
                                </div>
                                <p>This action cannot be undone from the portal.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Subscription</button>
                                <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>
